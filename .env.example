# ============================================================
# .env.example
# Copy this to .env and fill in your actual API keys.
# NEVER commit .env to git — it contains secrets.
# ============================================================

# ── LiveKit ──────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Soniox STT ───────────────────────────────────────────────
SONIOX_API_KEY=your_soniox_api_key
SONIOX_BASE_URL=wss://stt-rt.in.soniox.com/transcribe-websocket
# Options: 'soniox' (default) or 'whisper'
STT_PROVIDER=soniox

# ── LLM (OpenRouter) ─────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# ── Experimental Jev conversation decision model (disabled by default) ──
# Set true only when you want to test Jev. If disabled or unavailable,
# the existing Python PolicySelector remains active.
JEV_DECISION_ENABLED=false
JEV_MODEL=typesafe/jev-1.14
JEV_TIMEOUT_SECONDS=1.5
JEV_MIN_CONFIDENCE=0.55

# ── Cartesia TTS ─────────────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_VOICE_ID=26bfa541-7cb2-49b2-a2a2-c07cfec33e9d

# ── Greeting WAV file ────────────────────────────────────────
GREETING_WAV_PATH=assets/greeting.wav

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
