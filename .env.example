# ============================================================
# .env.example
# Copy this to .env and fill in your actual API keys.
# NEVER commit .env to git — it contains secrets.
# ============================================================

# ── LiveKit ──────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Soniox STT ───────────────────────────────────────────────
SONIOX_API_KEY=your_soniox_api_key
SONIOX_BASE_URL=wss://stt-rt.in.soniox.com/transcribe-websocket
# Options: 'soniox' (default) or 'whisper'
STT_PROVIDER=soniox

# ── LLM (Groq; prompt caching is automatic for supported models) ──
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.6
GROQ_MAX_COMPLETION_TOKENS=256

# ── Cartesia TTS ─────────────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_api_key
# Get this from your Cartesia dashboard under "Voices"
# Must be a voice that supports Telugu (sonic-multilingual model)
CARTESIA_VOICE_ID=your_cartesia_voice_id

# ── Greeting WAV file ────────────────────────────────────────
GREETING_WAV_PATH=assets/greeting.wav

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
